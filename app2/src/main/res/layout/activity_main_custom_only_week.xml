<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <com.haibin.calendarview.CalendarLayout
        android:id="@+id/calendarLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:calendar_show_mode="only_week_view"
        android:orientation="vertical">


        <com.haibin.calendarview.CalendarView
            android:id="@+id/calendarView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFF"
            app:calendar_match_parent="true"
            app:calendar_padding="4dp"
            app:current_day_text_color="#fe4031"
            app:current_month_text_color="#000"
            app:day_text_size="20sp"
            app:min_year="2020"
            app:month_view="com.demo.calendar.view.SimpleBlackMonthView"
            app:month_view_auto_select_day="first_day_of_month"
            app:other_month_text_color="#a1a1a1"
            app:selected_text_color="#fe4031"
            app:selected_theme_color="#fe4031"
            app:week_text_color="@color/black"
            app:week_bar_height="80dp"
            app:week_view_full_screen="true"
            app:week_view="com.demo.calendar.view.SimpleBlackWeekView"
            app:week_bar_view="com.demo.calendar.view.SimpleBlackWeekBar" />
        <!--  week_bar_view ，week_text_size 和 week_text_color 无效-->

    </com.haibin.calendarview.CalendarLayout>

    <Button
        android:id="@+id/btn_day_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="@string/open_day_panel" />
</LinearLayout>